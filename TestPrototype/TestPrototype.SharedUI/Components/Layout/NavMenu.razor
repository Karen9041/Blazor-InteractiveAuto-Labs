@using TestPrototype.SharedUI.Components.Common
@using TestPrototype.SharedUI.Services
@inject NavigationManager NavManager
@inject IAuthService AuthService

<div class="nav-scrollable" onclick="document.querySelector('.nav-item').click()">
    <nav class="flex-column">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house" aria-hidden="true"></span> 大廳動態
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="/app-simulator">
                <span class="bi bi-person" aria-hidden="true"></span> APP模擬登入
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link cursor-pointer" @onclick="OpenNotifications">
                <span class="notification"><NotificationBell /></span>通知
            </NavLink>
        </div>
    </nav>
</div>

@code{
    private async Task OpenNotifications()
    {
        if (!await AuthService.RequireLoginAsync())
        {
            return;
        }
        NavManager.NavigateTo("/notifications");
	}
}
