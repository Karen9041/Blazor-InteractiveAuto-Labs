<CascadingAuthenticationState>
    <Router AppAssembly="typeof(TestPrototype.SharedUI.Components.Routes).Assembly" AdditionalAssemblies="new[] { typeof(TestPrototype.SharedUI.Pages.Home).Assembly }">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(TestPrototype.SharedUI.Components.Layout.MainLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(TestPrototype.SharedUI.Components.Layout.MainLayout)">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
