@page "/login"
@page "/{Culture:length(5)}/login"
@inject IAuthService AuthService
@inject NavigationManager Navigation
@using TestPrototype.SharedUI.Models
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

<div class="login-container d-flex flex-column gap-1">
	<h2>歡迎</h2>
	<p>請輸入您的帳號密碼</p>
	<div>
		<input @bind="username" type="text" placeholder="輸入測試帳號" />
	</div>
	<div>
		<input @bind="password" type="password" placeholder="密碼(隨便打)" />
	</div>
	<button @onclick="HandleLogin" disabled="@isLoading" class="">@(isLoading ? "登入中..." : "立即登入")</button>
	<button @onclick="HandleGoogleLogin" disabled="@isLoading" class="">@(isLoading ? "登入中..." : "Google")</button>
    <button @onclick="HandleAppleLogin" disabled="@isLoading" class="">@(isLoading ? "登入中..." : "Apple")</button>

	@if(!string.IsNullOrEmpty(errorMessage))
	{
		<p class="error-message text-danger">@errorMessage</p>
	}
</div>

@code{
	[Parameter] public string? Culture { get; set; }
	private string username = "";
	private string password = "";
	private bool isLoading = false;
	private string errorMessage = "";
	

	private async Task HandleLogin()
	{
		isLoading = true;
		errorMessage = "";

		var success = await AuthService.LoginAsync(new LoginRequestDto { Username = username, Password = password });

		if(success)
		{
			// 登入成功，導回首頁
			Navigation.NavigateToLocalized("/");
		}
		else
		{
			errorMessage = "登入失敗，請檢查帳號密碼";
		}
		isLoading = false;
	}

	private async Task HandleGoogleLogin()
	{
		isLoading = true;
		errorMessage = "";

		// var clientId = @Configuration["Authentication:Google:ClientId"];
		// var redirectUri = @Configuration["Authentication:Google:RedirectUri"];
		var clientId = "721934805089-v033jop88cti47e0vsrl0jdu3je7g5nl.apps.googleusercontent.com";
		var redirectUri = "https://localhost:7288/google-callback";
		var scope = Uri.EscapeDataString("openid profile email");
		var state = Guid.NewGuid().ToString("N"); 
		var googleAuthUrl = $"https://accounts.google.com/o/oauth2/v2/auth" +
									$"?client_id={clientId}" +
									$"&redirect_uri={redirectUri}" +
									$"&response_type=code" +
									$"&scope={scope}" +
									$"&state={state}" +
									$"&prompt=select_account";

		// 叫瀏覽器直接跳轉到 Google 登入頁
		Navigation.NavigateTo(googleAuthUrl, forceLoad: true);
		isLoading = false;
	}
    private async Task HandleAppleLogin()
    {
        isLoading = true;
        errorMessage = "";

        // var clientId = @Configuration["Authentication:Google:ClientId"];
        // var redirectUri = @Configuration["Authentication:Google:RedirectUri"];
        var clientId = "club.jacfit";
        //var redirectUri = "https://community.jacfit.club/apple-callback";
        var redirectUri = "https://antivirus-giggly-enzyme.ngrok-free.dev/api/auth/apple-callback";
   
        var scope = Uri.EscapeDataString("name email");
        var state = Guid.NewGuid().ToString("N");
        //var appleAuthUrl = $"https://appleid.apple.com/auth/authorize?client_id={clientId}&redirect_uri={redirectUri}&response_type=code%20id_token&response_mode=form_post&scope={scope}&state={state}";
        var appleAuthUrl = $"https://appleid.apple.com/auth/authorize?client_id={clientId}&redirect_uri={redirectUri}&response_type=code&response_mode=form_post&scope={scope}&state={state}";

        // 叫瀏覽器直接跳轉到 Apple 登入頁
        Navigation.NavigateTo(appleAuthUrl, forceLoad: true);
        isLoading = false;
    }
}
