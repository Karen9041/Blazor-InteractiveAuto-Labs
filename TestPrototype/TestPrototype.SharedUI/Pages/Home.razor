@using TestPrototype.SharedUI.Components.Common
@using TestPrototype.SharedUI.Models
@using TestPrototype.SharedUI.Services
@using TestPrototype.SharedUI.Services.StateService
@inject NavigationManager NavManager
@inject CategoryStateService CategoryState
@inject PostStateService PostState
@implements IDisposable
@page "/"
@page "/{Culture:length(5)}/"


<div class="home-container d-flex flex-column">
	<div class="category-container d-flex" style="height:63px">
		<StateBoundary State="@CategoryState.CurrentUIState">
			<LoadingContent>
				<CategoryNavSkelenton />
			</LoadingContent>
			<EmptyContent>
				<div class="text-muted small ms-3">目前尚無分類</div>
			</EmptyContent>
			<ErrorContent>
				<span>⚠️ 載入失敗</span>
				<i class="bi bi-arrow-clockwise" style="cursor: pointer;" @onclick="CategoryState.LoadCategoriesAsync"></i>
			</ErrorContent>
			<ChildContent>
				<CategoryNav />
			</ChildContent>
		</StateBoundary>
    </div>
    <div class="post-container d-flex flex-column justify-content-center gap-4 w-100 ">
		<StateBoundary State="@PostState.CurrentUIState">
			<LoadingContent>
				@for(int i = 0; i < 3; i++)
				{
					<PostCardSkelenton />
				}
			</LoadingContent>
			<EmptyContent>
				<div>目前沒有貼文，去發一篇吧！</div>
			</EmptyContent>
			<ErrorContent>
				<div>糟糕，載入失敗。 <button @onclick="ReloadDataAsync">重試</button></div>
			</ErrorContent>
			<ChildContent>
				@if (!FilteredPosts.Any())
				{
				<div class="text-center text-muted my-5">
					<p class="mt-2">這個分類目前還沒有貼文喔！</p>
				</div>
				}
				else
				{
					@foreach (var post in FilteredPosts)
					{
						<PostCard PostData="post" />
					}
				}
			</ChildContent>
		</StateBoundary>
    </div>
</div>

@code{
	[Parameter]
	public string Culture{ get; set; } = "zh-TW";
	//接收網址上的 ?tag= 參數
	[SupplyParameterFromQuery(Name = "tag")]
	public string? SearchTag { get; set; }

	protected override async Task OnInitializedAsync()
	{
		CategoryState.OnChange += StateHasChanged;
		PostState.OnChange += StateHasChanged;

		await Task.WhenAll(
			CategoryState.EnsureInitialCategoriesLoadedAsync(),
			PostState.EnsureInitialTimelineLoadedAsync());
		StateHasChanged();
	}

	private async Task ReloadDataAsync()
	{
		await PostState.LoadTimeLineAsync();
		StateHasChanged();
	}

	private IEnumerable<PostDto> FilteredPosts
	{
		get
		{
			var posts = PostState.Posts.AsEnumerable();

			// 如果有帶 tag 參數，就把符合該 tag 的貼文「排在最前面」(置頂)
			if (!string.IsNullOrEmpty(SearchTag))
			{
				posts = posts.OrderByDescending(p => p.Content.Contains(SearchTag));
			}

			if (CategoryState.SelectedCategory == "綜合大廳")
			{
				return posts;
			}
			return posts.Where(p => p.Category == CategoryState.SelectedCategory);
		}
	}

	public void Dispose()
	{
		CategoryState.OnChange -= StateHasChanged;
		PostState.OnChange -= StateHasChanged;
	}
}

