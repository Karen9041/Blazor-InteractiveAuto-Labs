@using TestPrototype.SharedUI.Components
@inject IPreferenceService PreferenceService

@{
    // SSR 階段：向 ServerPreferenceService 詢問 Cookie 裡的 theme 設定
    // 因為這是在 @code 外面，且是同步渲染階段，我們直接呼叫 Result 取值 (這裡的情境允許這麼做)
    var themeCookie = PreferenceService.GetValueAsync("theme").Result;
    var dataTheme = themeCookie == "dark" ? "dark" : "light";
}
<!DOCTYPE html>
<html lang="en" data-theme="@dataTheme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="TestPrototype.styles.css" />

    <link rel="stylesheet" href="_content/TestPrototype.SharedUI/css/app.min.css" />

    <HeadOutlet @rendermode="InteractiveAuto" />
</head>

<body>
    <Routes @rendermode="InteractiveAuto" />
    <script src="_framework/blazor.web.js"></script>
	<script src="_content/TestPrototype.SharedUI/js/cookieHelper.js"></script>
</body>

</html>
